export struct CalendarDay {
    label: string,
    state: int,
}

export struct CalendarWeek {
    monday: CalendarDay,
    tuesday: CalendarDay,
    wednesday: CalendarDay,
    thursday: CalendarDay,
    friday: CalendarDay,
    saturday: CalendarDay,
    sunday: CalendarDay,
}

component DayCell inherits Rectangle {
    in property <CalendarDay> day;

    horizontal-stretch: 1;
    height: 36px;
    border-radius: 9px;
    background: root.day.state == 1 ? #F6E2EA : (root.day.state == 2 ? #342633 : #F8F5F7);

    Text {
        text: root.day.label;
        visible: root.day.label != "";
        color: root.day.state == 2 ? #FFFFFF : (root.day.state == 1 ? #813A59 : #514452);
        font-size: 13px;
        font-weight: root.day.state == 2 ? 700 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component CalendarScreen inherits Rectangle {
    in property <string> month-label;
    in property <[CalendarWeek]> calendar-weeks;
    in property <string> history-summary;
    in property <string> status-message;

    callback save-period-start(string);
    in-out property <string> date-input: "";

    background: #FAF7F8;

    VerticalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 20px;
        padding-bottom: 14px;
        spacing: 12px;

        VerticalLayout {
            spacing: 3px;

            Text {
                text: "Calendar";
                color: #342633;
                font-size: 25px;
                font-weight: 750;
            }

            Text {
                text: "Your period history, at a glance.";
                color: #665B67;
                font-size: 13px;
            }
        }

        Rectangle {
            background: #FFFFFF;
            border-color: #E8E0E5;
            border-width: 1px;
            border-radius: 18px;
            height: 286px;
            width: parent.width;

            VerticalLayout {
                padding: 14px;
                spacing: 8px;

                Text {
                    text: root.month-label;
                    color: #342633;
                    font-size: 17px;
                    font-weight: 700;
                }

                GridLayout {
                    spacing: 4px;

                    Row {
                        for weekday in ["M", "T", "W", "T", "F", "S", "S"] : Text {
                            text: weekday;
                            horizontal-stretch: 1;
                            color: #756876;
                            font-size: 11px;
                            font-weight: 700;
                            horizontal-alignment: center;
                        }
                    }

                    for week in root.calendar-weeks : Row {
                        DayCell { day: week.monday; }
                        DayCell { day: week.tuesday; }
                        DayCell { day: week.wednesday; }
                        DayCell { day: week.thursday; }
                        DayCell { day: week.friday; }
                        DayCell { day: week.saturday; }
                        DayCell { day: week.sunday; }
                    }
                }

                HorizontalLayout {
                    spacing: 12px;

                    Rectangle {
                        background: #F6E2EA;
                        border-radius: 5px;
                        width: 9px;
                        height: 9px;
                    }
                    Text {
                        text: "Period start";
                        color: #665B67;
                        font-size: 11px;
                    }
                    Rectangle {
                        background: #342633;
                        border-radius: 5px;
                        width: 9px;
                        height: 9px;
                    }
                    Text {
                        text: "Today";
                        color: #665B67;
                        font-size: 11px;
                    }
                }
            }
        }

        Rectangle {
            background: #FFFFFF;
            border-color: #E8E0E5;
            border-width: 1px;
            border-radius: 18px;
            height: 205px;
            width: parent.width;

            VerticalLayout {
                padding: 15px;
                spacing: 8px;

                Text {
                    text: "Log a period";
                    color: #342633;
                    font-size: 17px;
                    font-weight: 700;
                }

                Text {
                    text: "Choose the first day of bleeding.";
                    color: #665B67;
                    font-size: 12px;
                }

                Rectangle {
                    background: #FFFFFF;
                    border-color: #A99BA7;
                    border-width: 1px;
                    border-radius: 11px;
                    height: 48px;
                    width: parent.width;

                    Text {
                        text: "YYYY-MM-DD";
                        color: #756876;
                        font-size: 14px;
                        x: 13px;
                        vertical-alignment: center;
                        visible: root.date-input == "";
                    }

                    period-date-input := TextInput {
                        text: root.date-input;
                        color: #342633;
                        font-size: 15px;
                        selection-background-color: #E9C7D5;
                        selection-foreground-color: #342633;
                        text-cursor-width: 2px;
                        x: 13px;
                        y: 0px;
                        width: parent.width - 26px;
                        height: parent.height;
                        vertical-alignment: center;
                    }

                    root.date-input <=> period-date-input.text;
                }

                Rectangle {
                    background: #A64D70;
                    border-radius: 11px;
                    width: parent.width;
                    height: 48px;

                    Text {
                        text: "Save period start";
                        color: #FFFFFF;
                        font-size: 14px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        clicked => { root.save-period-start(root.date-input); }
                    }
                }

                Text {
                    text: root.status-message;
                    color: #813A59;
                    font-size: 11px;
                    wrap: word-wrap;
                }
            }
        }

        Rectangle {
            background: #F2E8EE;
            border-radius: 14px;
            height: 62px;
            width: parent.width;

            VerticalLayout {
                padding: 11px;
                spacing: 3px;

                Text {
                    text: "HISTORY";
                    color: #72586C;
                    font-size: 10px;
                    font-weight: 700;
                    letter-spacing: 1px;
                }

                Text {
                    text: root.history-summary;
                    color: #514452;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }
        }

        Rectangle {
            background: transparent;
            vertical-stretch: 1;
        }
    }
}
