export component InsightsScreen inherits Rectangle {
    in property <int> cycles-tracked;
    in property <string> average-cycle-label;
    in property <int> checkins-tracked;
    in property <string> history-summary;

    background: #FAF7F8;

    VerticalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 20px;
        padding-bottom: 18px;
        spacing: 14px;

        VerticalLayout {
            spacing: 3px;

            Text {
                text: "Insights";
                color: #342633;
                font-size: 25px;
                font-weight: 750;
            }

            Text {
                text: "Patterns from personal tracking history.";
                color: #665B67;
                font-size: 13px;
            }
        }

        HorizontalLayout {
            spacing: 9px;

            Rectangle {
                background: #F2E8EE;
                border-radius: 16px;
                horizontal-stretch: 1;
                height: 104px;

                VerticalLayout {
                    padding: 13px;
                    spacing: 5px;

                    Text {
                        text: "CYCLES";
                        color: #72586C;
                        font-size: 10px;
                        font-weight: 700;
                    }
                    Text {
                        text: root.cycles-tracked;
                        color: #342633;
                        font-size: 25px;
                        font-weight: 750;
                    }
                    Text {
                        text: "completed";
                        color: #665B67;
                        font-size: 11px;
                    }
                }
            }

            Rectangle {
                background: #EEEAF4;
                border-radius: 16px;
                horizontal-stretch: 1;
                height: 104px;

                VerticalLayout {
                    padding: 13px;
                    spacing: 5px;

                    Text {
                        text: "AVERAGE";
                        color: #675A75;
                        font-size: 10px;
                        font-weight: 700;
                    }
                    Text {
                        text: root.average-cycle-label;
                        color: #342633;
                        font-size: 20px;
                        font-weight: 750;
                    }
                    Text {
                        text: "cycle length";
                        color: #665B67;
                        font-size: 11px;
                    }
                }
            }
        }

        Rectangle {
            background: #FFFFFF;
            border-color: #E8E0E5;
            border-width: 1px;
            border-radius: 17px;
            height: 112px;
            width: parent.width;

            VerticalLayout {
                padding: 15px;
                spacing: 6px;

                Text {
                    text: "DAILY CHECK-INS";
                    color: #72586C;
                    font-size: 10px;
                    font-weight: 700;
                    letter-spacing: 1px;
                }

                Text {
                    text: root.checkins-tracked;
                    color: #342633;
                    font-size: 24px;
                    font-weight: 750;
                }

                Text {
                    text: "days with a saved check-in";
                    color: #665B67;
                    font-size: 12px;
                }
            }
        }

        Rectangle {
            background: #FFFFFF;
            border-color: #E8E0E5;
            border-width: 1px;
            border-radius: 17px;
            height: 145px;
            width: parent.width;

            VerticalLayout {
                padding: 15px;
                spacing: 8px;

                Text {
                    text: "YOUR TRACKING HISTORY";
                    color: #72586C;
                    font-size: 10px;
                    font-weight: 700;
                    letter-spacing: 1px;
                }

                Text {
                    text: root.history-summary;
                    color: #514452;
                    font-size: 13px;
                    wrap: word-wrap;
                }

                Text {
                    text: "Symptom patterns and cycle comparisons will appear as more entries are collected.";
                    color: #665B67;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }
        }

        Rectangle {
            background: transparent;
            vertical-stretch: 1;
        }

        Text {
            text: "Estimates are based on personal history.";
            color: #756876;
            font-size: 11px;
            horizontal-alignment: center;
        }
    }
}
