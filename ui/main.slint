import { Button, LineEdit } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "Miora";
    min-width: 320px;
    min-height: 600px;
    preferred-width: 390px;
    preferred-height: 780px;
    background: #fbf8fb;

    callback save-period-start(string);

    in-out property <string> cycle_day_label: "No period logged yet";
    in-out property <string> last_period_label: "Add a period start date to begin.";
    in-out property <string> status_message: "Your data stays on this device.";

    VerticalLayout {
        padding: 24px;
        spacing: 16px;

        Rectangle {
            background: transparent;
            height: 74px;

            VerticalLayout {
                alignment: start;
                spacing: 2px;

                Text {
                    text: "miora";
                    color: #392b3c;
                    font-size: 30px;
                    font-weight: 700;
                }

                Text {
                    text: "Understand your rhythm.";
                    color: #847786;
                    font-size: 14px;
                }
            }
        }

        Rectangle {
            background: #f0e6ef;
            border-radius: 24px;
            height: 190px;

            VerticalLayout {
                padding: 22px;
                spacing: 12px;

                Text {
                    text: "YOUR CYCLE";
                    color: #806c80;
                    font-size: 11px;
                    letter-spacing: 1px;
                }

                Text {
                    text: root.cycle_day_label;
                    color: #392b3c;
                    font-size: 25px;
                    font-weight: 700;
                    wrap: word-wrap;
                }

                Text {
                    text: root.last_period_label;
                    color: #756777;
                    font-size: 13px;
                    wrap: word-wrap;
                }

                Rectangle {
                    background: #ddc9dc;
                    height: 1px;
                }

                Text {
                    text: "Cycle estimates will appear as your history grows.";
                    color: #756777;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }
        }

        Text {
            text: "TRACK YOUR PERIOD";
            color: #806c80;
            font-size: 11px;
            letter-spacing: 1px;
        }

        Text {
            text: "When did the latest period start?";
            color: #392b3c;
            font-size: 17px;
            font-weight: 600;
            wrap: word-wrap;
        }

        period_date_input := LineEdit {
            placeholder-text: "YYYY-MM-DD  ·  e.g. 2026-11-08";
            height: 48px;
        }

        Button {
            text: "Save period start";
            height: 48px;
            clicked => {
                root.save-period-start(period_date_input.text);
            }
        }

        Text {
            text: root.status_message;
            color: #756777;
            font-size: 12px;
            wrap: word-wrap;
        }

        Rectangle {
            background: transparent;
            vertical-stretch: 1;
        }

        Text {
            text: "PRIVATE BY DESIGN";
            color: #a193a2;
            font-size: 10px;
            letter-spacing: 1px;
            horizontal-alignment: center;
        }

        Text {
            text: "Stored locally on this device.";
            color: #a193a2;
            font-size: 11px;
            horizontal-alignment: center;
        }
    }
}
